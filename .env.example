# ---------------------------------------------------------------------------
# Database: Postgres on Railway.
#   On Railway (the website service): reference the private URL, ${{Postgres.DATABASE_URL}}
#   On a PC: the Postgres service > Variables > DATABASE_PUBLIC_URL
#   Locally with nothing else: `npm run db:local` prints a URL for an embedded Postgres.
# TLS is automatic for remote hosts (src/lib/dbConnection.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/wbc

# Public origin, used for links in texts and emails and for Google sign-in callbacks.
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Google sign-in for /admin (console.cloud.google.com > Credentials > OAuth client, Web application).
# Redirect URI: <SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts that are always admins (comma-separated). Others are added from the Admins page.
ADMIN_EMAILS=
# Local development only (ignored by production builds): act as this admin without Google.
# DEV_ADMIN_EMAIL=you@example.com

# Railway storage bucket (S3-compatible) for uploads. Bucket > Credentials tab.
# Leave blank locally to keep uploads in data/uploads/.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
# BUCKET_FORCE_PATH_STYLE=true

# Texts (Twilio). Leave blank until the A2P 10DLC campaign is approved; the site still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of: the Messaging Service (preferred) or the number itself.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Email (Resend). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="West Building Center <deals@westbuildingcenter.com>"

TZ=America/Chicago
