// West Building Center — one table per real-world thing.
// Deer blinds and Milwaukee picks are both CatalogItems; contact forms, quote
// requests and project estimates are all Inquiries; a person who gets texts
// and/or emails is one Subscriber. Extend an enum before adding a table.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Sign-in (better-auth manages these four). Only allowlisted emails get in:
// see Admin below and src/lib/auth.ts.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

/// Who may open /admin. ADMIN_EMAILS in the environment are always allowed
/// (the owners' bootstrap); everyone else is added here from the Admins page.
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  addedBy   String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Content the owners manage
// ---------------------------------------------------------------------------

enum PromotionKind {
  PROMO
  EVENT
}

/// A time-boxed thing people get alerted about: a Milwaukee flyer (PROMO) or
/// Milwaukee Days (EVENT). "Active" is derived from the dates, never stored.
model Promotion {
  id          String        @id @default(cuid())
  kind        PromotionKind @default(PROMO)
  slug        String        @unique
  title       String
  brand       String?
  summary     String?
  /// Longer text shown on the promo page (plain text, blank lines = paragraphs).
  body        String?
  /// Storage key of the flyer PDF, if there is one.
  pdfKey      String?
  /// Storage key of the cover image (flyer page 1 or an event graphic).
  imageKey    String?
  startsAt    DateTime?
  endsAt      DateTime?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  catalogItems CatalogItem[]
  broadcasts   Broadcast[]

  @@index([kind, publishedAt, endsAt])
}

enum CatalogCategory {
  BLIND
  TOOL
  OUTDOOR
  DECKING
  KITCHEN
  LUMBER
  OTHER
}

/// Anything with a photo and a price: hunting blinds, the homepage Top 6
/// picks, future rentals. `featured` + `sortOrder` drive the homepage picks.
model CatalogItem {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  category    CatalogCategory
  brand       String?
  description String?
  priceCents  Int?
  /// Shown instead of or after the price: "call for price", "from".
  priceNote   String?
  /// "4 left", "back in stock" — free text the owner types.
  stockNote   String?
  /// Short label on the photo: "$100 OFF", "FREE BATTERY".
  badge       String?
  imageKeys   String[]        @default([])
  active      Boolean         @default(true)
  featured    Boolean         @default(false)
  sortOrder   Int             @default(0)
  /// The flyer this deal opens, when it is part of a promotion.
  promotionId String?
  promotion   Promotion?      @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, active, sortOrder])
  @@index([featured, active, sortOrder])
}

enum ProjectTag {
  NEW_HOME
  SIDING
  KITCHEN
  BATH
  SHOP_BARN
  OUTDOOR
  DECK
  ROOFING
  WINDOWS_DOORS
  OTHER
}

enum ProjectStatus {
  SUBMITTED
  PUBLISHED
  HIDDEN
}

/// The "Built with West Building Center" gallery. A customer's upload creates
/// a SUBMITTED row directly; the owner tags it and publishes it.
model Project {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  tags             ProjectTag[]  @default([])
  caption          String?
  /// "LP SmartSide, Wolf cabinets, quartz countertops"
  materials        String?
  body             String?
  imageKeys        String[]      @default([])
  status           ProjectStatus @default(SUBMITTED)
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  location         String?
  /// Who sent it in (customer submissions); not shown publicly.
  submittedName    String?
  submittedContact String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, featured, sortOrder])
}

enum ChannelStatus {
  NONE
  PENDING
  ACTIVE
  STOPPED
}

enum ConsentSource {
  WEB
  IN_STORE
  PHONE
  IMPORT
}

/// One row per person. Channel status lives on the row: a STOP text sets
/// smsStatus = STOPPED, an unsubscribe link sets emailStatus = STOPPED.
model Subscriber {
  id               String        @id @default(cuid())
  name             String?
  /// E.164, e.g. +16605550123
  phone            String?       @unique
  email            String?       @unique
  smsStatus        ChannelStatus @default(NONE)
  emailStatus      ChannelStatus @default(NONE)
  consentSource    ConsentSource @default(WEB)
  consentAt        DateTime?
  /// Text of the consent they agreed to (web) or the admin who typed them in.
  consentNote      String?
  smsConfirmedAt   DateTime?
  emailConfirmedAt DateTime?
  stoppedAt        DateTime?
  /// Lets the person manage or unsubscribe from a link without signing in.
  manageToken      String        @unique
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([smsStatus])
  @@index([emailStatus])
}

enum BroadcastStatus {
  QUEUED
  SENDING
  DONE
  FAILED
}

/// One row per "Send alert" click: the audit trail. Per-message delivery
/// detail stays with Twilio / the email provider.
model Broadcast {
  id          String          @id @default(cuid())
  promotionId String?
  promotion   Promotion?      @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  smsText     String?
  emailSubject String?
  status      BroadcastStatus @default(QUEUED)
  smsSent     Int             @default(0)
  smsFailed   Int             @default(0)
  emailSent   Int             @default(0)
  emailFailed Int             @default(0)
  error       String?
  sentBy      String
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([promotionId, createdAt])
}

enum InquiryType {
  CONTACT
  QUOTE
  ACCOUNT
  PROJECT_ESTIMATE
}

enum InquiryStatus {
  NEW
  REPLIED
  CLOSED
}

/// Every form on the site lands here: contact, business quote, open an
/// account, start a project estimate (with uploaded plans in fileKeys).
model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType
  status    InquiryStatus @default(NEW)
  name      String
  company   String?
  phone     String?
  email     String?
  message   String
  /// Storage keys of uploaded plans / photos.
  fileKeys  String[]      @default([])
  /// Form-specific extras (project type, timeline, part list) as a flat object.
  meta      Json?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

/// Owner-editable copy and store facts: hours, phone, hero text, banner.
/// Keys and defaults live in src/lib/content.ts; a row overrides the default.
model ContentBlock {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}
